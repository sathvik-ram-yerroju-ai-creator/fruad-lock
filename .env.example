# =============================================================================
# 🛡️ ARISE / FRAUD LOCK: Environment Variables Template
# =============================================================================

# Supabase Public API Configuration
# Obtain these from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Vite Compatible Variable Aliases
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Application Base URL (Used for Supabase Auth redirect URLs)
# Local: http://localhost:3000
# Production: https://cyber-lock-sable.vercel.app
NEXT_PUBLIC_APP_URL=https://cyber-lock-sable.vercel.app
VITE_APP_URL=https://cyber-lock-sable.vercel.app

# Optional: Google Gemini API Key for Server-Side AI Analysis
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Local Mock Auth Mode (Enabled only for isolated local testing without Supabase)
# Set to 'false' or leave unset in production
NEXT_PUBLIC_ENABLE_MOCK_AUTH=false
