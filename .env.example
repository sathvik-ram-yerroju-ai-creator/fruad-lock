# =============================================================================
# 🛡️ FRAUD LOCK: Environment Variables Template
# =============================================================================

# Supabase Public API Configuration (Client-side)
# Obtain these from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Optional: Google Gemini API Key for Server-Side AI Analysis (Edge Functions & Next.js API Routes)
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Google Safe Browsing Threat Intelligence API Key
SAFE_BROWSING_API_KEY=your_safe_browsing_key_here

# Optional: Supabase Auth & OTP Settings
SUPABASE_AUTH_OTP_EXPIRY_SECONDS=600

# Optional: Twilio Configuration (Configured in Supabase Dashboard -> Auth -> Providers -> Phone)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
